<div class="slide-inner hero-layout">
  <header>
    <div class="accent-bar"></div>
    <div class="slide-kicker">{{page_role}}</div>
  </header>
  <section>
    <h1 class="hero-title">{{page_title}}</h1>
    <p class="hero-message">{{key_message}}</p>
  </section>
  <footer class="slide-footer">
    <span>{{deck_title}}</span>
    <span>{{page_number}} / {{total_pages}}</span>
  </footer>
</div>
<aside class="notes" hidden>{{speaker_notes}}</aside>

