<div class="slide-inner">
  <header class="slide-meta">{{page_role}}</header>
  <section class="big-idea">
    <p class="statement">{{key_message}}</p>
    <p class="slide-subtitle">{{sub_headline}}</p>
  </section>
  <footer class="slide-footer">
    <span>{{page_title}}</span>
    <span>{{page_number}} / {{total_pages}}</span>
  </footer>
</div>
<aside class="notes" hidden>{{speaker_notes}}</aside>

