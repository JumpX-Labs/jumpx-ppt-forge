<div class="slide-inner">
  <header>
    <div class="slide-kicker">{{page_role}}</div>
    <h2 class="slide-title">{{page_title}}</h2>
  </header>
  <section class="content-grid two-col">
    <div class="image-placeholder">
      {{image_block}}
    </div>
    <div class="slide-body">
      <p>{{key_message}}</p>
      {{body_items}}
    </div>
  </section>
  <footer class="slide-footer">
    <span>{{caption}}</span>
    <span>{{page_number}} / {{total_pages}}</span>
  </footer>
</div>
<aside class="notes" hidden>{{speaker_notes}}</aside>

